[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://stage_scene.gd" id="1_stage"]
[ext_resource type="PackedScene" path="res://flow/gpu_stage/gpu_flow_stage_2d.tscn" id="2_flow"]

[node name="McCloudPitScreen" type="Node2D"]
script = ExtResource("1_stage")

[node name="FlowModel2D" parent="." instance=ExtResource("2_flow")]
stage_index = 1
model_id = &"mccloud_pit_flow"
screen_id = &"mccloud_pit"
stage_title = "McCloud-Pit Rivers"
debug_visible = true
regime_profile_physics_enabled = true
model_start_day_index = 181
watershed_data_path = "res://flow/data/water_pipeline/mccloud_720.txt"
stage_temperature_visible = true
temperature_data_path = "res://flow/data/water_pipeline/water_temperature_all_rivers_720.txt"
temperature_data_column = "mccloud_above_shasta_lake_temp_c"
