[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://stage_scene.gd" id="1_stage"]
[ext_resource type="PackedScene" path="res://flow/gpu_stage/gpu_flow_stage_2d.tscn" id="2_flow"]

[node name="DeltaScreen" type="Node2D"]
script = ExtResource("1_stage")

[node name="FlowModel2D" parent="." instance=ExtResource("2_flow")]
