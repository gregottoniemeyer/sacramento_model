debug_visible = true
regime_panel_visible = true
regime_heading_visible = false
regime_profile_physics_enabled = true
model_start_day_index = 181
watershed_data_path = "res://flow/data/water_pipeline/delta_720.txt"
stage_temperature_visible = true
temperature_data_path = "res://flow/data/water_pipeline/water_temperature_all_rivers_720.txt"
temperature_data_column = "delta_freeport_temp_c"
